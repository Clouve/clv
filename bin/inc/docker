#!/usr/bin/env bash
# Shared docker-run helper for all clv shims.
#
# Expects these to be set by the caller (the shim):
#   $CLVHOME            persistent home dir for this tool (~/.clv/<cmd>)
#   $IT                 -it or -i (REQUIRED — set by init/clv; an unset
#                       value injects an empty positional arg that breaks
#                       docker run)
#   $PUBLISHED_PORTS[]  optional, populated by inc/ports
#
# Optional environment input from the user:
#   CLV_DRY_RUN=1       print the docker command instead of running it
#   CLV_DOCKER_ARGS     extra flags inserted into `docker run` verbatim

clv_docker_run() {
  local extra_args=()
  if [[ -n "${CLV_DOCKER_ARGS:-}" ]]; then
    # word-split intentionally; users pass shell-style flags here
    # shellcheck disable=SC2206
    extra_args=( $CLV_DOCKER_ARGS )
  fi

  # Defensive: callers that don't source inc/ports leave PUBLISHED_PORTS unset.
  local published_ports=( "${PUBLISHED_PORTS[@]+"${PUBLISHED_PORTS[@]}"}" )

  # Defensive: callers that don't source inc/user leave USER_MOUNTS unset.
  local user_mounts=( "${USER_MOUNTS[@]+"${USER_MOUNTS[@]}"}" )

  local cmd=(
    docker run "$IT" --rm
    "${published_ports[@]}"
    "${extra_args[@]}"
    "${user_mounts[@]}"
    -v "$CLVHOME:/root"
    -v "$PWD:/clv"
    -w "/clv"
    "$@"
  )

  if [[ "${CLV_DRY_RUN:-}" == "1" ]]; then
    printf '%q ' "${cmd[@]}"
    printf '\n'
    return 0
  fi

  "${cmd[@]}"
}
