#!/usr/bin/env bash
SCRIPT_PATH="$(
  cd "$(dirname "$0")" || exit
  pwd -P
)"
source "$SCRIPT_PATH"/init/clv kubectl
source "$SCRIPT_PATH"/inc/user
source "$SCRIPT_PATH"/inc/docker
clv_docker_run --entrypoint kubectl \
    -v "$CLVHOME/.kube:/.kube" \
    -e KUBECONFIG=/.kube/config \
    "bitnami/kubectl:${CLV_TAG:-latest}" "$@"
