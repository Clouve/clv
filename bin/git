#!/usr/bin/env bash
SCRIPT_PATH="$(
  cd "$(dirname "$0")" || exit
  pwd -P
)"
source "$SCRIPT_PATH"/init/clv alpine/git
source "$SCRIPT_PATH"/inc/user
source "$SCRIPT_PATH"/inc/ssh
source "$SCRIPT_PATH"/inc/docker
clv_docker_run \
    --entrypoint git \
    "${SSH_MOUNTS[@]}" \
    "alpine/git:${CLV_TAG:-latest}" "$@"
