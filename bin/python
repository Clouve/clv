#!/usr/bin/env bash
SCRIPT_PATH="$(
  cd "$(dirname "$0")" || exit
  pwd -P
)"
source "$SCRIPT_PATH"/init/clv python
source "$SCRIPT_PATH"/inc/ports
source "$SCRIPT_PATH"/inc/docker
clv_docker_run \
    --entrypoint python \
    -e PYTHONUSERBASE=/root/base \
    "python:${CLV_TAG:-3.13-slim}" "$@"
