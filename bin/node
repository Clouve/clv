#!/usr/bin/env bash
SCRIPT_PATH="$(
  cd "$(dirname "$0")" || exit
  pwd -P
)"
source "$SCRIPT_PATH"/init/clv node
source "$SCRIPT_PATH"/inc/ports
source "$SCRIPT_PATH"/inc/docker
clv_docker_run \
    --entrypoint node \
    -e PATH="/root/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    "node:${CLV_TAG:-lts}" "$@"
