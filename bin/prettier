#!/usr/bin/env bash
SCRIPT_PATH="$(
  cd "$(dirname "$0")" || exit
  pwd -P
)"
source "$SCRIPT_PATH"/init/clv prettier
# shellcheck disable=SC2034  # consumed by sourcing inc/docker; shares node's persistent home
CLVHOME="$CLV/node"
source "$SCRIPT_PATH"/inc/user
source "$SCRIPT_PATH"/inc/docker
clv_docker_run \
    --entrypoint prettier \
    -e PATH="/root/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    "node:${CLV_TAG:-lts}" "$@"
